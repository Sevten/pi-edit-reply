{
  "name": "@sevten/pi-edit-reply",
  "version": "0.2.0",
  "description": "A pi coding agent extension to rewrite LLM replies and reasoning.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "ai-agent",
    "llm",
    "session",
    "conversation",
    "chat-history",
    "edit",
    "fork",
    "branch",
    "conversation-tree"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sevten/pi-edit-reply.git"
  },
  "bugs": {
    "url": "https://github.com/Sevten/pi-edit-reply/issues"
  },
  "homepage": "https://github.com/Sevten/pi-edit-reply#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc extensions/edit-reply.ts --outDir out --module esnext --target es2022 --moduleResolution bundler --strict --skipLibCheck --types node",
    "test": "npm run build && node tests/e2e-test.mjs"
  }
}
